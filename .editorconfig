root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[Makefile]
indent_style = tab

# Archived inputs and source copies must not be reformatted on save.
[v6/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
