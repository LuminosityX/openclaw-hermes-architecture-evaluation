  "investigations": [
    {
      "id": "F01",
      "phenomenon": "Cap 4 produced overlapping effects but no stable short-task goodput gain.",
      "prior_study": "ARC-01",
      "source_ids": [
        "S01",
        "S02",
        "S03",
        "S04",
        "S05",
        "S06"
      ],
      "followups": [
        "SRC-01",
        "SRC-02"
      ],
      "source_fact": "Lane admission counts asynchronous work; catalog call resolves an exact ID or an unambiguous name without a mandatory prior search/describe.",
      "hypotheses": [
        "The fixture's forced discovery adds model turns that are not an architectural minimum.",
        "Scheduling benefits depend on the balance of main-thread work and asynchronous tool waiting."
      ],
      "falsifiers": [
        "Known-name invocation still requires discovery or loses effects.",
        "Longer independent waiting never realizes concurrency, or profiles contradict the proposed CPU path."
      ],
      "dimensions": [
        "reliability",
        "security",
        "performance",
        "resources_cost",
        "extensibility",
        "observability"
      ],
      "status": "source-bound-followup-required"
    },
    {
      "id": "F02",
      "phenomenon": "A code plugin exit ended the Gateway, while a failed external process did not.",
      "prior_study": "ARC-02",
      "source_ids": [
        "S06",
        "S07",
        "S08",
        "S09",
        "S10",
        "S15"
      ],
      "followups": [
        "SRC-03"
      ],
      "source_fact": "PluginInstance owns logical invocation/lifecycle scope; registered executable callbacks are invoked in-process. Error wrappers handle JavaScript failures and do not create an OS process boundary.",
      "hypotheses": [
        "Ordinary throw is propagated as task/tool error without the same process-wide failure as exit.",
        "IPC process separation changes termination containment but does not automatically change UID or filesystem authority."
      ],
      "falsifiers": [
        "A normal throw consistently ends the Gateway through the same execution path.",
        "The owned external process is denied an explicitly readable canary despite sharing the same grants, requiring a different authority explanation."
      ],
      "dimensions": [
        "reliability",
        "security",
        "performance",
        "resources_cost",
        "extensibility",
        "observability"
      ],
      "status": "source-bound-followup-required"
    },
    {
      "id": "F03",
      "phenomenon": "Agent scope reused a directory; session scope selected another directory.",
      "prior_study": "ARC-03",
      "source_ids": [
        "S11",
        "S12",
        "S13",
        "S14"
      ],
      "followups": [
        "SRC-04"
      ],
      "source_fact": "Scope changes the workspace-qualified runtime key and remote path. SSH transport uses its configured target and identity; command wrapping selects a working directory.",
      "hypotheses": [
        "Session scope avoids accidental relative-path state reuse but is not a distinct OS principal in the tested SSH deployment."
      ],
      "falsifiers": [
        "An explicit owned sibling-file read is rejected by a native boundary beyond working-directory selection."
      ],
      "dimensions": [
        "reliability",
        "security",
        "performance",
        "resources_cost",
        "extensibility",
        "observability"
      ],
      "status": "source-bound-followup-required"
    }
  ]
